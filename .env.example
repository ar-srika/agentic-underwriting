# Google Gemini API Key (required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-3.5-pro

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Security
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,txt,docx

# Pricing Constraints
MAX_PREMIUM=10000
MIN_PREMIUM=500

# Risk Thresholds
AUTO_APPROVE_THRESHOLD=35
MANUAL_REVIEW_THRESHOLD=65
AUTO_DECLINE_THRESHOLD=80
